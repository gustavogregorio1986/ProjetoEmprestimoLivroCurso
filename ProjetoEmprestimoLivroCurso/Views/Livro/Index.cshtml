@using ProjetoEmprestimoLivroCurso.Models
@model IEnumerable<LivroModel>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success text-dark" role="alert">
        @TempData["MensagemSucesso"]
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger text-dark" role="alert">
        @TempData["MensagemErro"]
    </div>
}

<div class="container mt-5">

    <div class="btn btn-box d-flex justify-content-between align-items-center mb-3">
        <h2>Cadastrar Livros!</h2>
        <a class="btn btn-success" asp-action="Cadastrar" asp-controller="Livro"> <i class="bi bi-plus-circle"></i> Cadastrar novo livro</a>

    </div>
     
    
     <table class="table table-hover">
         <thead>
             <tr>
                 <th>Titulo</th>
                 <th>Autor</th>
                 <th>Genero</th>
                 <th>Quantidade em Estoque</th>
                 <th></th>
             </tr>
         </thead>
         <tbody>
          
            @if (Model != null && Model.Any())
            {
                @if(Model.Count() > 0)
                {
                    @foreach (var livro in Model)
                    {
                      <tr>
                        @if (livro.Capa != null)
                        {
                           <td>
                             <img src="@livro.Capa" style="width:50px; height:50px;" />
                           </td>
                        }
                        else
                        {
                            <td></td>        
                        }
                        <td><i class="bi bi-people"></i> @livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td>@livro.Genero</td>
                        <td><i class="bi bi-envelope-at"></i>@livro.QuatidadeEmEstoque</td>
                        <td><i class="bi bi-calendar"></i>@livro.DataDeCadastro</td>
                        <td>
                            <a class="btn btn-warning"><i class="bi bi-file-earmark-zip"></i> Detalhes</a>
                            <a class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
                        </td>
                     </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="texte-center">Sem Livros Registrados</td></tr>
                }
            }
        </tbody>
     </table>

</div>